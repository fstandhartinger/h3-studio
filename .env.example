# ComfyUI endpoint on the RunPod pod. RunPod exposes any http port declared on the
# pod at https://<podId>-<port>.proxy.runpod.net — no tunnel needed.
COMFY_URL=https://<podId>-8188.proxy.runpod.net

# Shared password for the UI. If unset the app is OPEN to anyone with the URL.
APP_PASSWORD=change-me

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Optional: when the pod is scheduled to be auto-terminated (ISO8601).
# Drives the countdown in the status bar.
POD_DEADLINE=2026-08-05T14:47:00Z

# Optional, for the cost estimate shown in the UI.
GPU_USD_PER_HOUR=2.09
